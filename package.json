{
  "name": "cipher-brain",
  "version": "0.0.1",
  "type": "module",
  "description": "Encrypt a gbrain snapshot so only the key holder can read it (age X25519). Produces one backend-agnostic ciphertext for censorship-resistant storage.",
  "keywords": [
    "age",
    "encryption",
    "backup",
    "arweave",
    "mcp",
    "second-brain",
    "permanent-storage",
    "snapshot",
    "x25519",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Masashi-Ono0611/cipher-brain.git"
  },
  "homepage": "https://github.com/Masashi-Ono0611/cipher-brain#readme",
  "bugs": {
    "url": "https://github.com/Masashi-Ono0611/cipher-brain/issues"
  },
  "author": "Masashi Ono (https://github.com/Masashi-Ono0611)",
  "files": [
    "dist"
  ],
  "bin": {
    "cipher-brain": "dist/cli.mjs",
    "cipher-brain-mcp": "dist/mcp.mjs"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status --since=origin/main",
    "format": "biome format --write .",
    "check:help-docs": "node scripts/check-help-docs.mjs",
    "verify": "node scripts/verify.mjs",
    "selftest": "bash scripts/selftest.sh",
    "selftest:profiles": "bash scripts/selftest-profiles.sh",
    "selftest:cipherbrainignore": "bash scripts/selftest-cipherbrainignore.sh",
    "selftest:interop": "bash scripts/selftest-interop.sh",
    "selftest:storage": "bash scripts/selftest-storage.sh",
    "selftest:rclone": "bash scripts/selftest-rclone.sh",
    "selftest:recovery": "bash scripts/selftest-recovery.sh",
    "selftest:pq": "bash scripts/selftest-pq.sh",
    "selftest:minisign": "bash scripts/selftest-minisign.sh",
    "selftest:verify-levels": "bash scripts/selftest-verify-levels.sh",
    "selftest:schedule": "bash scripts/selftest-schedule.sh",
    "selftest:init": "bash scripts/selftest-init.sh",
    "selftest:help-docs": "bash scripts/selftest-help-docs.sh",
    "selftest:arweave": "node scripts/arweave-roundtrip.mjs",
    "selftest:arweave-nodeps": "node scripts/selftest-arweave-nodeps.mjs",
    "selftest:usd-rate": "node scripts/selftest-usd-rate.mjs",
    "selftest:error-codes": "node scripts/selftest-error-codes.mjs",
    "selftest:progress": "node --experimental-strip-types --import ./scripts/dev-cli-loader.mjs scripts/selftest-progress.mjs",
    "selftest:config-file": "bash scripts/selftest-config-file.sh",
    "verify:suite": "npm run build && npm run typecheck && npm run lint && npm run check:help-docs && npm run selftest && npm run selftest:profiles && npm run selftest:cipherbrainignore && npm run selftest:interop && npm run selftest:storage && npm run selftest:rclone && npm run selftest:recovery && npm run selftest:pq && npm run selftest:minisign && npm run selftest:verify-levels && npm run selftest:schedule && npm run selftest:config-file && npm run selftest:init && npm run selftest:help-docs && npm run selftest:arweave && npm run selftest:arweave-nodeps && npm run selftest:usd-rate && npm run selftest:error-codes && npm run selftest:progress && bash scripts/cli-smoke.sh && node scripts/mcp-smoke.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@ardrive/turbo-sdk": "^1.42.0",
    "arweave": "^1.15.0"
  },
  "peerDependenciesMeta": {
    "@ardrive/turbo-sdk": {
      "optional": true
    },
    "arweave": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.0",
    "arlocal": "^1.1.66",
    "arweave": "^1.15.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "age-encryption": "^0.3.0",
    "ignore": "^7.0.6"
  }
}
